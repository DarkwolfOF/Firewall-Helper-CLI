#!/usr/bin/env bash
#
# firewall-helper-cli (frwll)
# A simple, universal CLI helper to manage firewall ports (firewalld, UFW, IPTables).
#

set -euo pipefail

# Color definitions
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Global variables
PORT=""
PROTO=""

show_help() {
    cat << EOF
${BLUE}firewall-helper-cli (frwll)${NC} - Quick & universal firewall management

${YELLOW}USAGE:${NC}
  frwll <command> [options]

${YELLOW}COMMANDS:${NC}
  open <port>[/proto]    Opens the specified port permanently (defaults to /tcp).
  close <port>[/proto]   Closes/Blocks the specified port permanently (defaults to /tcp).
  status [port[/proto]]  Shows overall active rules or checks a specific port.
  help                   Displays this help message.

${YELLOW}EXAMPLES:${NC}
  frwll open 80           # Opens port 80/tcp permanently
  frwll open 53/udp       # Opens port 53/udp permanently
  frwll close 22/tcp      # Closes port 22/tcp permanently
  frwll status            # Lists all managed ports and their status
  frwll status 443        # Checks if port 443/tcp is open or close
EOF
}

check_root() {
    if [[ $EUID -ne 0 ]]; then
        echo -e "${RED}Error:${NC} This command requires root privileges. Please run with 'sudo frwll'." >&2
        exit 1
    fi
}

# Detect active firewall backend
detect_backend() {
    if command -v firewall-cmd >/dev/null 2>&1 && systemctl is-active --quiet firewalld 2>/dev/null; then
        echo "firewalld"
    elif command -v ufw >/dev/null 2>&1 && ufw status | grep -q "active"; then
        echo "ufw"
    elif command -v iptables >/dev/null 2>&1; then
        echo "iptables"
    else
        echo -e "${RED}Error:${NC} No active firewall backend found (Firewalld, UFW, or IPTables)." >&2
        exit 1
    fi
}

# Parse and validate port/protocol input (<port> or <port>/<proto>)
parse_port_proto() {
    local input="$1"
    
    if [[ "$input" =~ ^([0-9]+)$ ]]; then
        PORT="${BASH_REMATCH[1]}"
        PROTO="tcp"
    elif [[ "$input" =~ ^([0-9]+)/(tcp|udp)$ ]]; then
        PORT="${BASH_REMATCH[1]}"
        PROTO="${BASH_REMATCH[2]}"
    else
        echo -e "${RED}Error:${NC} Invalid port format. Use '<port>' or '<port>/<tcp|udp>' (e.g. 80 or 53/udp)." >&2
        exit 1
    fi

    if (( PORT < 1 || PORT > 65535 )); then
        echo -e "${RED}Error:${NC} Port number must be between 1 and 65535." >&2
        exit 1
    fi
}

# --- BACKEND FUNCTIONS WITH STEP-BY-STEP FEEDBACK ---

# 1. Firewalld
firewalld_open() {
    echo "Executing firewalld commands..."
    echo "  -> Adding port ${PORT}/${PROTO} to public zone..."
    firewall-cmd --zone=public --add-port="${PORT}/${PROTO}" --permanent >/dev/null 2>&1
    echo "  -> Reloading firewall rules..."
    firewall-cmd --reload >/dev/null 2>&1
}

firewalld_close() {
    echo "Executing firewalld commands..."
    echo "  -> Removing port ${PORT}/${PROTO} from public zone..."
    firewall-cmd --zone=public --remove-port="${PORT}/${PROTO}" --permanent >/dev/null 2>&1 || true
    echo "  -> Reloading firewall rules..."
    firewall-cmd --reload >/dev/null 2>&1
}

firewalld_is_open() {
    firewall-cmd --zone=public --query-port="${PORT}/${PROTO}" >/dev/null 2>&1
}

firewalld_list() {
    local ports
    ports=$(firewall-cmd --zone=public --list-ports)
    if [[ -z "$ports" ]]; then
        echo "No custom ports configured in firewalld."
        return
    fi
    for p in $ports; do
        echo -e "${p} ${GREEN}open${NC}"
    done
}

# 2. UFW
ufw_open() {
    echo "Executing UFW commands..."
    echo "  -> Allowing port ${PORT}/${PROTO}..."
    ufw allow "${PORT}/${PROTO}" >/dev/null 2>&1
}

ufw_close() {
    echo "Executing UFW commands..."
    echo "  -> Removing/denying rule for port ${PORT}/${PROTO}..."
    ufw delete allow "${PORT}/${PROTO}" >/dev/null 2>&1 || ufw deny "${PORT}/${PROTO}" >/dev/null 2>&1
}

ufw_is_open() {
    ufw status | grep -E "^${PORT}/${PROTO}\s+ALLOW" >/dev/null 2>&1
}

ufw_list() {
    local raw_rules
    raw_rules=$(ufw status | grep -E "^[0-9]+/(tcp|udp)") || true
    if [[ -z "$raw_rules" ]]; then
        echo "No active port rules in UFW."
        return
    fi
    echo "$raw_rules" | while read -r line; do
        local target action
        target=$(echo "$line" | awk '{print $1}')
        action=$(echo "$line" | awk '{print $2}')
        if [[ "$action" == "ALLOW" ]]; then
            echo -e "${target} ${GREEN}open${NC}"
        else
            echo -e "${target} ${RED}close${NC}"
        fi
    done
}

# 3. IPTables
iptables_open() {
    echo "Executing IPTables commands..."
    echo "  -> Inserting ACCEPT rule for port ${PORT}/${PROTO} in INPUT chain..."
    if ! iptables_is_open; then
        iptables -I INPUT -p "$PROTO" --dport "$PORT" -j ACCEPT >/dev/null 2>&1
    fi
}

iptables_close() {
    echo "Executing IPTables commands..."
    echo "  -> Removing ACCEPT rule for port ${PORT}/${PROTO} from INPUT chain..."
    iptables -D INPUT -p "$PROTO" --dport "$PORT" -j ACCEPT >/dev/null 2>&1 || true
}

iptables_is_open() {
    iptables -C INPUT -p "$PROTO" --dport "$PORT" -j ACCEPT >/dev/null 2>&1
}

iptables_list() {
    local rules
    rules=$(iptables -L INPUT -n --line-numbers | grep -E "(dpt:|dports)") || true
    if [[ -z "$rules" ]]; then
        echo "No active input port rules detected in IPTables."
        return
    fi
    echo "$rules" | while read -r line; do
        local proto target port
        proto=$(echo "$line" | awk '{print $3}' | tr '[:upper:]' '[:lower:]')
        target=$(echo "$line" | awk '{print $2}')
        port=$(echo "$line" | grep -oP 'dpt:\K[0-9]+')
        
        if [[ -n "$port" ]]; then
            if [[ "$target" == "ACCEPT" ]]; then
                echo -e "${port}/${proto} ${GREEN}open${NC}"
            else
                echo -e "${port}/${proto} ${RED}close${NC}"
            fi
        fi
    done
}

# --- MAIN COMMANDS ---

cmd_open() {
    check_root
    parse_port_proto "$1"
    local backend
    backend=$(detect_backend)

    echo "Opening port ${PORT}/${PROTO} permanently..."

    case "$backend" in
        firewalld) firewalld_open ;;
        ufw)       ufw_open ;;
        iptables)  iptables_open ;;
    esac

    echo -e "Done! Port ${PORT}/${PROTO} is now open. ${GREEN}OK!${NC}"
}

cmd_close() {
    check_root
    parse_port_proto "$1"
    local backend
    backend=$(detect_backend)

    echo "Closing port ${PORT}/${PROTO} permanently..."

    case "$backend" in
        firewalld) firewalld_close ;;
        ufw)       ufw_close ;;
        iptables)  iptables_close ;;
    esac

    echo -e "Done! Port ${PORT}/${PROTO} is now closed. ${GREEN}OK!${NC}"
}

cmd_status() {
    check_root
    local backend
    backend=$(detect_backend)

    # Specific port check: frwll status <port>[/proto]
    if [[ $# -gt 0 ]]; then
        parse_port_proto "$1"
        local is_open=1

        case "$backend" in
            firewalld) firewalld_is_open && is_open=0 ;;
            ufw)       ufw_is_open && is_open=0 ;;
            iptables)  iptables_is_open && is_open=0 ;;
        esac

        if [[ $is_open -eq 0 ]]; then
            echo -e "${PORT}/${PROTO} ${GREEN}open${NC}"
        else
            echo -e "${PORT}/${PROTO} ${RED}close${NC}"
        fi
        return
    fi

    # List all active ports: frwll status
    case "$backend" in
        firewalld) firewalld_list ;;
        ufw)       ufw_list ;;
        iptables)  iptables_list ;;
    esac
}

main() {
    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi

    case "$1" in
        open)
            shift
            [[ $# -eq 0 ]] && { echo -e "${RED}Error:${NC} Please specify a port."; exit 1; }
            cmd_open "$1"
            ;;
        close)
            shift
            [[ $# -eq 0 ]] && { echo -e "${RED}Error:${NC} Please specify a port."; exit 1; }
            cmd_close "$1"
            ;;
        status)
            shift
            cmd_status "$@"
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            echo -e "${RED}Error:${NC} Unknown command '$1'."
            show_help
            exit 1
            ;;
    esac
}

main "$@"
